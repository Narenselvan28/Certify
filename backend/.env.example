# =============================================================================
# Certify — Environment Configuration (Brevo Transactional Email)
# =============================================================================

# Brevo API Key (Keep strictly backend-only. Never expose to frontend or git.)
BREVO_API_KEY=your_brevo_api_key_here

# Verified Brevo Sender
BREVO_SENDER_EMAIL=certificates@example.com
BREVO_SENDER_NAME=Certify

# Test mode: when true, validates and simulates delivery without calling the real Brevo API
BREVO_TEST_MODE=true

# Delivery parameters
MAX_EMAIL_RETRIES=3
EMAIL_SEND_DELAY_MS=100
EMAIL_BATCH_SIZE=50

# Attachment size limit (MB)
MAX_CERTIFICATE_SIZE_MB=10

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
