# ==============================================================================
# Certify Multi-Channel Delivery Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ==============================================================================

# ===============================
# 1. WHATSAPP BUSINESS CLOUD API
# ===============================
# Obtain these from Meta Business Manager > WhatsApp > API Setup

# Permanent system user access token (or temporary token for testing)
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# Phone Number ID (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Graph API version (e.g. v19.0)
WHATSAPP_API_VERSION=v19.0

# Pre-approved WhatsApp message template name in Meta Business Manager
# Leave blank to use document-with-caption fallback
CERTIFICATE_TEMPLATE_NAME=certificate_delivery
CERTIFICATE_TEMPLATE_LANGUAGE=en

# Set to "true" to simulate delivery without calling Meta API
WHATSAPP_TEST_MODE=true


# ===============================
# 2. EMAIL (SMTP)
# ===============================
# Works with Gmail SMTP, Outlook, institutional/college SMTP, AWS SES, or SendGrid

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Certify
SMTP_USE_TLS=true

# Set to "true" to simulate email delivery without dispatching actual emails
EMAIL_TEST_MODE=true

EMAIL_SUBJECT_TEMPLATE=Your Certificate – {event_name}
EMAIL_BODY_TEMPLATE=Dear {name},\n\nThank you for participating in {event_name}.\n\nPlease find your participation certificate attached.\n\nRegards,\n{from_name}


# ===============================
# 3. DELIVERY QUEUE & RATE LIMITS
# ===============================

# Maximum retry attempts for transient failures (e.g. 429, timeouts, 500s)
MAX_DELIVERY_RETRIES=3

# Worker concurrency (1 = strictly sequential; increase for higher throughput)
DELIVERY_CONCURRENCY=1

# Inter-job rate-limit delay in milliseconds (e.g. 500ms between dispatches)
DELIVERY_DELAY_MS=500

# Simulated failure rate for testing queue error handling (0.0 to 1.0; 0 in production)
DELIVERY_SIMULATE_FAILURE_RATE=0.0

# Maximum certificate PDF size in MB
MAX_CERTIFICATE_SIZE_MB=10


# ===============================
# 4. CORS
# ===============================
# Comma-separated list of allowed frontend origins (local dev + GitHub Pages)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:3000
