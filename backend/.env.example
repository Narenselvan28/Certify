# ──────────────────────────────────────────────────────────────────────────────
# Certify Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────
# Obtain these from Meta Business Manager > WhatsApp > API Setup

# Your permanent system user access token (or temporary token for testing)
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# The Phone Number ID (NOT the phone number itself) from your WhatsApp Business Account
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Your WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Graph API version — check Meta docs for the latest stable version
WHATSAPP_API_VERSION=v19.0

# ── Message Template ──────────────────────────────────────────────────────────
# Pre-approved WhatsApp message template name (created in Meta Business Manager)
# Leave blank to use a document-with-caption fallback (requires messaging window)
CERTIFICATE_TEMPLATE_NAME=certificate_delivery
CERTIFICATE_TEMPLATE_LANGUAGE=en

# ── Development / Testing ─────────────────────────────────────────────────────
# Set to "true" to simulate delivery without calling the WhatsApp API.
# IMPORTANT: Set to "false" in production — never leave test mode on accidentally.
WHATSAPP_TEST_MODE=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For production, set ONLY your GitHub Pages URL:
#   ALLOWED_ORIGINS=https://your-username.github.io
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_CERTIFICATE_SIZE_MB=10
